{
  "name": "flow-behind-cli",
  "version": "1.0.0",
  "description": "Flow Behind CLI — local image and video workflows for Google Flow and compatible browser extensions.",
  "type": "module",
  "license": "MIT",
  "author": "Flow Behind",
  "private": true,
  "bin": {
    "flow-behind": "bin/flow-behind.mjs",
    "flow-behind-mcp": "bin/flow-behind-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "tools/inpaint.py",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/autostart.test.js test/bridge.test.js test/compatibility.test.js test/core.test.js test/mcp.test.js test/media.test.js",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behindofficial/flow-behind-cli.git"
  },
  "homepage": "https://github.com/behindofficial/flow-behind-cli#readme",
  "bugs": {
    "url": "https://github.com/behindofficial/flow-behind-cli/issues"
  },
  "keywords": [
    "google-flow",
    "cli",
    "mcp",
    "ai-video",
    "image-generation",
    "browser-automation"
  ]
}
